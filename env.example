# Copy to .env for local runs, or set in Render (never commit real values).
# Production API: https://support-leaderboard-backend-jprw.onrender.com

PORT=3000
SERVE_STATIC=1

# Stripe (secret key must start with sk_test_ or sk_live_ — not pk_)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PRICE_ID=

# Site (Stripe success/cancel URLs — your deployed homepage)
SITE_URL=https://your-domain.com

# Supabase Leaderboard project (rvrrrcsveqpqnmzptxuj) — service role is server-only
SUPABASE_URL=https://rvrrrcsveqpqnmzptxuj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# Optional: comma-separated origins, or *
CORS_ORIGIN=*
